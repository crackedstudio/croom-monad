# Copy to .env and fill in. .env is gitignored and must stay that way.
# No private keys live in this file — see docs/keys.md.

# ---------------------------------------------------------------------------
# Monad
# ---------------------------------------------------------------------------
# Confirm both against docs.monad.xyz Network Information at step 1.1, then
# record what the RPC itself answers in docs/monad-facts.md.
MONAD_TESTNET_RPC=
MONAD_MAINNET_RPC=https://rpc.monad.xyz

# Explorer verification. Provider and key format are established at step 1.1.
MONAD_EXPLORER_API_KEY=

# ---------------------------------------------------------------------------
# drand
# ---------------------------------------------------------------------------
DRAND_API=https://api.drand.sh

# evmnet, scheme bls-bn254-unchained-on-g1. PLAN.md §3.1 states this hash;
# step 2.1 confirms it against the live API before anything hardcodes it.
DRAND_CHAIN_HASH=04f1e9062b8a81f848fded9c12306733282b2727ecced50032187751166ec8c3

# ---------------------------------------------------------------------------
# Signers — names of encrypted keystore accounts, never key material
# ---------------------------------------------------------------------------
DEPLOYER_ACCOUNT=croom-deployer
POSTER_ACCOUNT=croom-poster
CHALLENGER_ACCOUNT=croom-challenger
# Loses its bond on purpose during the demo. Keep it separate and keep it poor.
LIAR_ACCOUNT=croom-liar
